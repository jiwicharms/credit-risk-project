# Copy to .env and add your FRED key. .env is gitignored.
#   cp .env.example .env

# The only value you must supply.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Everything below has a working default. Change only if you provisioned
# resources under different names, or if you want to run a second copy
# alongside an existing one.

# PROJECT_NAME=credit-risk
# AWS_REGION=us-east-1
# REDSHIFT_DATABASE=dev
# REDSHIFT_SCHEMA=credit_risk_prod
# REDSHIFT_ROLE_NAME=RedshiftCreditRiskRole

# S3_BUCKET is derived as ${PROJECT_NAME}-${ACCOUNT_ID}-${REGION}, which is
# globally unique without you inventing one. Set it only to use a bucket you
# already own.
# S3_BUCKET=

# Pins FRED to a single revision so a clone reproduces the same numbers.
# FRED revises continuously; without this, identical code gives different
# data next quarter. Changing it invalidates any trained model.
FRED_VINTAGE=2026-08-31
