option_settings:
  aws:elasticbeanstalk:application:
    # Liveness must not depend on Redshift -- pointing this at /health/ready
    # means a paused Serverless workgroup makes the load balancer cycle
    # containers that are working fine.
    Application Healthcheck URL: /health
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Percentage
    BatchSize: 50
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 14
